# Copy to .env. Existing environment variables take precedence.
# Relative paths are resolved from the repository root.
PDM_PORT=8765
PDM_DEV_PORT=5173

# Empty values use OS-specific user data/cache directories (XDG on Linux).
PDM_DATA_DIR=
PDM_CACHE_DIR=
PDM_WEB_DIST=

# Codex is optional; install/login to the CLI separately to use AI features.
PDM_AGENT_ENABLED=1

# Optional Google OAuth Desktop app configuration. Never commit the real JSON.
PDM_GOOGLE_CLIENT_FILE=

# Optional verified LibreOffice WebAssembly runtime directory.
PDM_OFFICE_ASSETS=
